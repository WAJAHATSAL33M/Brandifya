# Never commit real credentials. Configure these in your deployment provider.
# Hostinger Business/Cloud MySQL. Copy the complete prefixed names from hPanel.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=u123456789_brande
DB_USER=u123456789_store
DB_PASSWORD=replace-with-your-database-password
# Keep false for Hostinger's local connection. Remote TLS uses true and optional DB_SSL_CA.
DB_SSL=false
# Optional alternative to DB_HOST/DB_NAME/DB_USER/DB_PASSWORD (URL-encode special characters):
DATABASE_URL=
STORE_LIVE=false
STORE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_CURRENCY=PKR
STORE_COUNTRY=PK
# Amount in minor currency units. Confirm inclusive-tax pricing before launch.
SHIPPING_MINOR=0
ENABLE_COD=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Use a randomly generated value of at least 32 characters.
# First owner setup only; remove after creating your account at /admin.
ADMIN_SETUP_TOKEN=

# Email accounts: use a verified sending domain with Resend.
RESEND_API_KEY=
AUTH_FROM_EMAIL=
# OAuth callbacks: STORE_URL/api/account/oauth/google and /facebook
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Pin a Graph API version supported by your Facebook app.
FACEBOOK_GRAPH_VERSION=



# Apple Sign in: Services ID, Developer Team ID, key ID and private .p8 contents.
# Callback must be HTTPS: STORE_URL/api/account/oauth/apple
# APPLE_PRIVATE_KEY accepts actual newlines or literal \n sequences. Never commit its value.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
