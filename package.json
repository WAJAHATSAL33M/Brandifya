{
  "name": "brandifya",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "db:setup": "node --env-file-if-exists=.env.local scripts/setup-db.mjs",
    "build:hostinger": "npm run db:setup && next build",
    "db:check": "node --env-file-if-exists=.env.local scripts/check-db.mjs",
    "test:database": "node --experimental-strip-types --test tests/database.integration.ts",
    "db:seed-demo": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/seed-demo.ts",
    "admin:reset": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/reset-admin.ts",
    "test:workspace": "node --experimental-strip-types tests/integration/mysql-workspace.cjs"
  },
  "dependencies": {
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.24.6",
    "next": "^15.5.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.2",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "22.x"
  }
}
